# Optional legacy HTTP fallback, used only without MinIO read configuration.
# Direct MinIO access does not require the parts platform or this API key.
RUIWARE_TEMPLATE_API_URL=http://127.0.0.1:8010

# Same read-only integration key as the zero-part platform.
# Copy this file to .env.local, fill in the real key, then restart FastAPI.
# Never use a VITE_ prefix for this key: it must stay on the server.
RUIWARE_PUBLIC_API_KEY=

# Shared drafts (default: .runtime/components.sqlite3).
COMPONENT_DRAFT_DB=.runtime/components.sqlite3

# Optional independent inbound MCP bearer token. Empty: loopback clients only.
# This protects /mcp only; remote deployment must also protect REST and the web app.
COMPONENT_MCP_TOKEN=

# Origin used in model URLs returned by MCP; no path suffix.
COMPONENT_PUBLIC_BASE_URL=http://127.0.0.1:8020

# Both part/component reads and component releases use this shared MinIO bucket.
# Reads require endpoint/credentials/bucket/read-prefix; publishing also needs prefix.
# Existing process/system variables take precedence over this file; no need to copy
# them here when they already exist. Do not put credentials in VITE_ variables.
# RUIWARE_MINIO_ENDPOINT=100.94.35.61:9000
# RUIWARE_MINIO_ACCESS_KEY=
# RUIWARE_MINIO_SECRET_KEY=
# RUIWARE_MINIO_BUCKET=ruiware-templates
# RUIWARE_MINIO_PREFIX=publishers/your-member-id
# RUIWARE_MINIO_READ_PREFIX=publishers
# RUIWARE_MINIO_SECURE=false
